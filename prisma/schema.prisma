generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Teacher {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  school       String?
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

model Session {
  id        String     @id @default(cuid())
  code      String     @unique
  title     String
  testId    String
  status    String     @default("open")
  createdAt DateTime   @default(now())
  teacherId String
  teacher   Teacher    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  responses Response[]

  @@index([teacherId])
}

model Response {
  id          String   @id @default(cuid())
  studentName String
  period      String
  answers     Json
  selfRatings Json
  score       Int
  maxScore    Int
  group       String
  createdAt   DateTime @default(now())
  sessionId   String
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}
